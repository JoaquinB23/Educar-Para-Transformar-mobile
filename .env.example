# --- API (backend local) ---
# IP de la PC que corre el backend, no localhost. Ajustá el puerto y el prefijo /api según sus rutas.
EXPO_PUBLIC_API_URL=http://192.168.0.0:3000/api

# --- Firebase (mismo proyecto que la web) ---
# Firebase Console > Configuración del proyecto > Tus apps > app web
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=