# Firebase Console → Configuración del proyecto → Tus apps → app Android → SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL del backend. Desde el celular no sirve localhost: usá la IP local de la PC
# (ej. http://192.168.X.X:3000) o una URL HTTPS de túnel.
EXPO_PUBLIC_API_URL=
