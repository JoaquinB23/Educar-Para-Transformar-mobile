{
  "expo": {
    "name": "educar-app",
    "slug": "educar-app",
    "scheme": "educarapp",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "android": {
      "package": "com.educar.app",
      "googleServicesFile": "./google-services.json"
    }
  }
}
